{
  "description": "Load repository task context when a Codex session begins.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.codex/hooks/session-start-context.sh",
            "timeout": 5,
            "statusMessage": "Loading repository task context"
          }
        ]
      }
    ]
  }
}
